# PostgreSQL Database Configuration
POSTGRES_DB=secassess
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secassess

# JWT Authentication
JWT_SECRET=supersecretjwtkeyforuniversityprojecttestingonly12345
JWT_EXPIRE_MINUTES=1440

# Security / CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External Tools and AI Services
# Use the same key for the ZAP service and backend; for a host-run backend use http://localhost:8080.
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=replace-with-a-random-zap-api-key
# Defaults; effective spider limits are hard-capped at depth 5 and 500 URLs.
ZAP_SPIDER_MAX_DEPTH=2
ZAP_SPIDER_MAX_URLS=200
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
AI_ENABLED=true
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_CALLS_PER_ASSESSMENT=20
AI_MAX_CALLS_PER_USER_PER_HOUR=10

# Seed Initial Credentials
SEED_ADMIN_EMAIL=admin@secassess.local
SEED_ADMIN_PASSWORD=AdminSecurePassword123!
SEED_ASSESSOR_EMAIL=assessor@secassess.local
SEED_ASSESSOR_PASSWORD=AssessorSecurePassword123!

# Report Generation and Dashboard (Phase 6)
REPORT_DIR=reports_storage
REPORT_FORMAT_PRIMARY=docx
LIBREOFFICE_PATH=soffice
REPORT_MAX_EXCERPT_CHARS=1500
REPORT_MAX_IMAGES=20
REPORT_MAX_IMAGE_WIDTH_PX=1200
REPORT_MAX_TOTAL_MB=50
REPORT_CLASSIFICATION="Confidential: Academic Assessment"
REPORT_GROUP_NAME="Security Assessment Group"
REPORT_COURSE="Cybersecurity Assessment Capstone"
REPORT_MEMBERS="Lead Assessor, Security Analyst"
DASHBOARD_TOP_FINDINGS=5
DASHBOARD_RECENT_ACTIVITY=10
